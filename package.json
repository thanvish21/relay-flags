{
  "name": "relay-flags",
  "version": "1.0.0",
  "private": true,
  "description": "A deterministic feature-flag evaluation engine for Node.js services.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run typecheck",
    "start": "npm run build && node dist/src/server.js",
    "cli": "npm run build && node dist/src/cli.js",
    "bench": "npm run build && node dist/bench/evaluate.bench.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
